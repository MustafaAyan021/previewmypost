		$$<HTMLInputElement>('[name="ig-theme"]').forEach(el=>el.addEventListener('change',()=>{state.igTheme=el.value as 'light'|'dark';renderFields();save();}));
		$$<HTMLInputElement>('[name="feed-ratio"]').forEach(el=>el.addEventListener('change',()=>{state.feedRatio=el.value as PreviewState['feedRatio'];renderFields();save();if(objectURLs.length)useImage(objectURLs[activeImageIndex],carouselFiles[activeImageIndex]||null);}));
		$$<HTMLInputElement>('[name="feed-width"]').forEach(el=>el.addEventListener('change',()=>{state.feedWidth=el.value as PreviewState['feedWidth'];renderFields();save();}));
		$<HTMLButtonElement>('[data-copy-caption]')?.addEventListener('click',async()=>{
			const status=$<HTMLElement>('[data-caption-action-status]');
			if(!state.caption.trim()){if(status)status.textContent='Caption is empty.';return;}
			try{await navigator.clipboard.writeText(state.caption);if(status)status.textContent='Caption copied.';}
			catch{if(status)status.textContent='Could not copy the caption.';}
		});
		$<HTMLButtonElement>('[data-clear-caption]')?.addEventListener('click',()=>{
			state.caption='';
			captionExpanded=false;
			renderFields();save();
			$<HTMLTextAreaElement>('[data-field="caption"]')?.focus();
			const status=$<HTMLElement>('[data-caption-action-status]');if(status)status.textContent='Caption cleared.';
		});
		$$<HTMLButtonElement>('[data-story-layout]').forEach(button=>button.addEventListener('click',()=>{state.storyLayout=button.dataset.storyLayout as 'post'|'media';renderFields();save();}));
		$$<HTMLInputElement>('[name="post-type"]').forEach(el=>el.addEventListener('change',()=>{root.dataset.postType=el.value;}));
		$<HTMLInputElement>('[data-safe-toggle]')?.addEventListener('change',e=>{state.safe=(e.currentTarget as HTMLInputElement).checked;renderFields();save();if(state.safe)emit('safe_zones_enabled');});
		$<HTMLInputElement>('[data-safe-everywhere]')?.addEventListener('change',e=>{state.safeEverywhere=(e.currentTarget as HTMLInputElement).checked;renderFields();save();});
		$$<HTMLButtonElement>('.card-safe-toggle').forEach(btn=>btn.addEventListener('click',()=>{state.safe=!state.safe;renderFields();}));
		$$<HTMLButtonElement>('[data-mode]').forEach(tab=>tab.addEventListener('click',()=>setMode(tab.dataset.mode as Mode)));
		$<HTMLElement>('.preview-tabs')?.addEventListener('keydown',(event)=>{
			if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;
			const tabs=$$<HTMLButtonElement>('[data-mode]');
			const current=tabs.indexOf(document.activeElement as HTMLButtonElement);
			if(current<0)return;
			event.preventDefault();
			const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(current+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;
			tabs[next].focus();
			setMode(tabs[next].dataset.mode as Mode);
		});
		$<HTMLSelectElement>('[data-mobile-mode]')?.addEventListener('change',e=>setMode((e.currentTarget as HTMLSelectElement).value as Mode));
		$$<HTMLButtonElement>('[data-caption-toggle]').forEach(btn=>btn.addEventListener('click',()=>{captionExpanded=!captionExpanded;renderFields();}));
		const gridContent=(tile:HTMLElement)=>[
			...tile.querySelectorAll<HTMLElement>(':scope > img, :scope > .safe-overlay'),
		];
		const insertGridContent=(tile:HTMLElement,nodes:HTMLElement[])=>{
			const firstControl=tile.querySelector('button');
			nodes.forEach(node=>firstControl?tile.insertBefore(node,firstControl):tile.append(node));
		};
		const swapGridTiles=(source:HTMLElement,target:HTMLElement)=>{
			if(source===target)return;
			const sourcePosition=Number(source.dataset.gridPosition);
			const targetPosition=Number(target.dataset.gridPosition);
			const sourceContent=gridContent(source);
			const targetContent=gridContent(target);
			sourceContent.forEach(node=>node.remove());
			targetContent.forEach(node=>node.remove());
			insertGridContent(source,targetContent);
			insertGridContent(target,sourceContent);
			const sourceURL=gridImageURLs[sourcePosition];
			const targetURL=gridImageURLs[targetPosition];
			delete gridImageURLs[sourcePosition];
			delete gridImageURLs[targetPosition];
			if(targetURL)gridImageURLs[sourcePosition]=targetURL;
			if(sourceURL)gridImageURLs[targetPosition]=sourceURL;
			if(source.classList.contains('active-upload')){
				source.classList.remove('active-upload');
				target.classList.add('active-upload');
				state.gridPosition=targetPosition;
			}else if(target.classList.contains('active-upload')){
				target.classList.remove('active-upload');
				source.classList.add('active-upload');
				state.gridPosition=sourcePosition;
			}
			updateGridCellControls();
		};
		let draggedGridTile:HTMLElement|null=null;
		let gridWasDragged=false;
		$$<HTMLElement>('[data-grid-position]').forEach(tile=>{
			tile.addEventListener('click',event=>{
				if((event.target as Element).closest('[data-grid-cell-remove]'))return;
				if(gridWasDragged){gridWasDragged=false;return;}
				if(!tile.classList.contains('active-upload')&&!tile.querySelector('.grid-placeholder-image'))openGridImagePicker(Number(tile.dataset.gridPosition));
			});
			tile.addEventListener('keydown',event=>{
				if((event.key==='Enter'||event.key===' ')&&event.target===tile&&!tile.classList.contains('active-upload')&&!tile.querySelector('.grid-placeholder-image')){event.preventDefault();openGridImagePicker(Number(tile.dataset.gridPosition));}
			});
