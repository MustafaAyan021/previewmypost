		const updateExploreTiles=()=>{
			$$<HTMLElement>('[data-explore-position]').forEach(tile=>{
				const active=tile.classList.contains('explore-active-upload');
				tile.draggable=active;
				tile.tabIndex=active?-1:0;
				tile.setAttribute('aria-label',active?`Uploaded post in Explore position ${Number(tile.dataset.explorePosition)+1}`:`Move uploaded post to Explore position ${Number(tile.dataset.explorePosition)+1}`);
			});
		};
		const moveExplorePost=(target:HTMLElement)=>{
			const active=$<HTMLElement>('.explore-active-upload');
