			const content=[...active.querySelectorAll<HTMLElement>(':scope > img[data-preview-image], :scope > .safe-overlay, :scope > .explore-upload-marker')];
			const views=target.querySelector(':scope > .explore-views');
			content.forEach(node=>views?target.insertBefore(node,views):target.append(node));
